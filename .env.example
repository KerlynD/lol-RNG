# Copy to .env and fill in real values. .env is gitignored.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Guild (server) ID where slash commands register instantly.
# Right-click your server in Discord (with Developer Mode on) → Copy Server ID.
DISCORD_GUILD_ID=

# Postgres connection string.
# Local: postgres://postgres:dev@localhost:5432/lolrng
# Fly:   set automatically when you run `fly postgres attach`
DATABASE_URL=

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Seed for deterministic drop-weight assignment on first DB init.
# Change this to re-roll champion weights (only takes effect on a fresh DB).
DROP_WEIGHT_SEED=lol-rng-v0
